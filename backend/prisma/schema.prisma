generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Exercise {
    id          Int      @id @default(autoincrement())
    name        String
    description String
    muscleGroup String
    imageUrl    String?
    videoUrl    String?
    difficulty  String?
    externalId  String?  
    sessions    SessionExercise[]
    createdAt   DateTime @default(now())
    coachId     Int?
    coach       Coach?   @relation("CoachExercises", fields: [coachId], references: [id])
}

model Coach {
    id          Int      @id @default(autoincrement())
    userId      Int      @unique
    user        User     @relation(fields: [userId], references: [id])
    bio         String?
    specialty   String?
    hourlyRate  Float?
    photoUrl    String?
    clients     User[]   @relation("CoachClients")
    createdAt   DateTime @default(now())
    exercises   Exercise[] @relation("CoachExercises")
    subscription  Subscription?
    stripeConnect StripeConnect?
}

model User {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    password  String
    role      String    @default("user")
    firstname String?
    lastname  String?
    weight    Float?
    height    Float?
    goal      String?
    gender    String?
    coachId   Int?
    coach     Coach?    @relation("CoachClients", fields: [coachId], references: [id])
    coachProfile Coach?
    sessions  Session[]
    createdAt DateTime  @default(now())
    passwordResetTokens PasswordResetToken[]

}

model Session {
    id          Int               @id @default(autoincrement())
    name        String
    userId      Int
    user        User              @relation(fields: [userId], references: [id])
    exercises   SessionExercise[]
    scheduledAt DateTime?
    createdAt   DateTime          @default(now())
    calories    Int?
    intensity   String?  // "low" | "medium" | "high"
}
model SessionExercise {
    id          Int      @id @default(autoincrement())
    sessionId   Int
    session     Session  @relation(fields: [sessionId], references: [id])
    exerciseId  Int
    exercise    Exercise @relation(fields: [exerciseId], references: [id])
    sets        Int
    reps        Int
    weight      Float?
}

model Subscription {
  id                   Int      @id @default(autoincrement())
  coachId              Int      @unique
  coach                Coach    @relation(fields: [coachId], references: [id])
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  plan                 String   // "starter" | "pro" | "elite"
  status               String   // "active" | "past_due" | "canceled"
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
}

model StripeConnect {
  id                 Int     @id @default(autoincrement())
  coachId            Int     @unique
  coach              Coach   @relation(fields: [coachId], references: [id])
  stripeAccountId    String  @unique
  onboardingComplete Boolean @default(false)
  payoutsEnabled     Boolean @default(false)
  createdAt          DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}