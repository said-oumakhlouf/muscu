generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Exercise {
    id          Int      @id @default(autoincrement())
    name        String
    description String
    muscleGroup String
    imageUrl    String?
    videoUrl    String?
    difficulty  String?
    sessions    SessionExercise[]
    createdAt   DateTime @default(now())
}

model Coach {
    id          Int      @id @default(autoincrement())
    userId      Int      @unique
    user        User     @relation(fields: [userId], references: [id])
    bio         String?
    specialty   String?
    photoUrl    String?
    clients     User[]   @relation("CoachClients")
    createdAt   DateTime @default(now())
}

model User {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    password  String
    role      String    @default("user")
    firstname String?
    lastname  String?
    weight    Float?
    height    Float?
    goal      String?
    gender    String?
    coachId   Int?
    coach     Coach?    @relation("CoachClients", fields: [coachId], references: [id])
    coachProfile Coach?
    sessions  Session[]
    createdAt DateTime  @default(now())
}

model Session {
    id          Int               @id @default(autoincrement())
    name        String
    userId      Int
    user        User              @relation(fields: [userId], references: [id])
    exercises   SessionExercise[]
    scheduledAt DateTime?
    createdAt   DateTime          @default(now())
}
model SessionExercise {
    id          Int      @id @default(autoincrement())
    sessionId   Int
    session     Session  @relation(fields: [sessionId], references: [id])
    exerciseId  Int
    exercise    Exercise @relation(fields: [exerciseId], references: [id])
    sets        Int
    reps        Int
    weight      Float?
}